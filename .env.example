# Plantilla de variables de entorno. Copiar a `.env` y ajustar los valores:
#   cp .env.example .env
# `docker compose up` no arranca sin un `.env`: el servicio `db` interpola
# POSTGRES_* desde este archivo para inicializar Postgres.

# Django
# Los defaults de settings.py son los seguros (DEBUG=False), así que el
# entorno de desarrollo tiene que activar DEBUG explícitamente aquí.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# En desarrollo se puede omitir: settings.py cae en una clave `django-insecure-`.
# En despliegue es OBLIGATORIA y debe ser secreta. Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=

# PostgreSQL
POSTGRES_DB=delivery_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Channels
REDIS_HOST=redis
REDIS_PORT=6379
